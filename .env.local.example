# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI (Whisper)
OPENAI_API_KEY=sk-...

# Vercel Blob (auto-inyectado si la integración está conectada)
BLOB_READ_WRITE_TOKEN=...
# Host público del bucket Blob — formato: https://<tenant-id>.public.blob.vercel-storage.com
# El tenant-id aparece en cualquier URL pública de un blob ya subido.
# Se usa para construir URLs cuando solo tenemos la key del objeto.
BLOB_PUBLIC_BASE_URL=https://<tenant-id>.public.blob.vercel-storage.com

# Vercel Postgres
POSTGRES_URL=...
POSTGRES_PRISMA_URL=...
POSTGRES_URL_NON_POOLING=...

# Auth.js
AUTH_SECRET=...
AUTH_URL=https://tu-dominio.vercel.app
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# ClickUp
CLICKUP_WEBHOOK_SECRET=...
CLICKUP_API_TOKEN=...

# Inngest
INNGEST_EVENT_KEY=...
INNGEST_SIGNING_KEY=...

# Upstash Redis
UPSTASH_REDIS_REST_URL=...
UPSTASH_REDIS_REST_TOKEN=...

# Remotion (opcional, si tienes licencia comercial)
# REMOTION_LICENSE_KEY=...

# Mirage / Captions.ai (opcional)
# Si se configura, reemplaza Whisper + Remotion en el pipeline.
# Mirage añade subtítulos automáticamente con su propio motor de transcripción.
# Límites: vídeos ≤50 MB, duración ≤1 min, formato 9:16.
# Obtén el template_id ejecutando: GET https://api.captions.ai/api/caption-templates
MIRAGE_API_KEY=sk-...
MIRAGE_CAPTION_TEMPLATE_ID=
