{
  "framework": "nextjs",
  "buildCommand": "npx remotion bundle remotion/index.ts && next build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "functions": {
    "app/api/inngest/route.ts": {
      "maxDuration": 300
    },
    "app/api/pipeline/route.ts": {
      "maxDuration": 30
    },
    "app/api/pipeline/[projectId]/download/route.ts": {
      "maxDuration": 60
    },
    "app/api/pipeline/[projectId]/regenerate-capcut/route.ts": {
      "maxDuration": 120
    },
    "app/api/cortar/[id]/download/route.ts": {
      "maxDuration": 60
    },
    "app/api/upload/route.ts": {
      "maxDuration": 60
    },
    "app/api/upload-guion/route.ts": {
      "maxDuration": 30
    },
    "app/api/webhooks/clickup/route.ts": {
      "maxDuration": 15
    },
    "app/api/migrate/route.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
